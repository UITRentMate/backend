# ==========================================
# RENTMATE BACKEND - LOCAL ENVIRONMENT CONFIG
# ==========================================

# Port chạy máy chủ Express
PORT=5000

# Chuỗi kết nối PostgreSQL (Prisma ORM)
# Định dạng: postgresql://<user>:<password>@<host>:<port>/<database>?schema=<schema>
# Thay 'your_password_here' bằng mật khẩu PostgreSQL thực tế trên máy của bạn
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/rentmate_dev?schema=public"

# Chuoi bi mat ngau nhien it nhat 32 ky tu, chi dung de ky JWT access token
JWT_SECRET="REPLACE_ME"
